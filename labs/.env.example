# ---------------------------------------------------------------------------
# Acme labs environment - copy to .env and edit.
#     cp .env.example .env
#
# NO REAL SECRETS BELONG IN THIS REPOSITORY. The values below are
# placeholders; `make doctor` refuses to run labs while `change-me-*`
# keys are in use AND anonymous access is off, so rotate them first.
# ---------------------------------------------------------------------------

# --- Weaviate cluster (docker-compose, 3 nodes on one host) ---------------
WEAVIATE_HTTP_HOST=localhost
WEAVIATE_HTTP_PORT=8080          # node weaviate-0 (nodes 1/2 on 8081/8082)
WEAVIATE_GRPC_HOST=localhost
WEAVIATE_GRPC_PORT=50051         # node weaviate-0 (nodes 1/2 on 50052/50053)

# All node HTTP ports, comma-separated, used by verify/chaos tooling.
WEAVIATE_NODE_HTTP_PORTS=8080,8081,8082
WEAVIATE_NODE_GRPC_PORTS=50051,50052,50053

# Compose service names (also RAFT voter names inside the cluster).
WEAVIATE_NODES=weaviate-0,weaviate-1,weaviate-2

# --- Auth (static API keys; RBAC root mapped to root-user) -----------------
# Rotate these before running anything. Keys map 1:1 to users:
#   WEAVIATE_API_KEY_ROOT     -> user 'root-user'     (RBAC built-in root)
#   WEAVIATE_API_KEY_READONLY -> user 'readonly-user' (assign built-in viewer
#                                role via API; see labs/README.md)
WEAVIATE_API_KEY_ROOT=change-me-root-key
WEAVIATE_API_KEY_READONLY=change-me-readonly-key

# --- Observability ----------------------------------------------------------
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000

# --- Optional knobs ---------------------------------------------------------
# Expected server version; verify.py fails preflight on mismatch.
WEAVIATE_EXPECTED_VERSION=1.38.3
# Compose project name (keeps volumes/network names stable across shells).
COMPOSE_PROJECT_NAME=acme
